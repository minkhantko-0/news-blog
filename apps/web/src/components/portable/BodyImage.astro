---
import type { MediaImage } from '~/lib/content';
import Img from '../ui/Img.astro';

interface Props {
  node: { image: MediaImage };
}

const { image } = Astro.props.node;
---

<figure class="not-prose my-8">
  <Img image={image} aspect={[3, 2]} sizes="(min-width: 1024px) 760px, 100vw" maxWidth={1600} />
  {
    (image.caption || image.credit) && (
      <figcaption class="text-muted mt-2 text-sm">
        {image.caption}
        {image.credit && <span class="ml-1 text-xs tracking-wide uppercase">Photo: {image.credit}</span>}
      </figcaption>
    )
  }
</figure>
