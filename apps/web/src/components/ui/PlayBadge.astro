---
/** Round play button shown over video stories. Decorative: the card link is the action. */
import Icon from './Icon.astro';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;
const sizes = {
  sm: 'size-8 border-2',
  md: 'size-10 border-2 lg:size-11',
  lg: 'size-12 border-[3px] sm:size-16',
};
---

<span
  class:list={[
    'inline-flex shrink-0 items-center justify-center rounded-full border-white bg-black/45 text-white backdrop-blur-[2px]',
    sizes[size],
    className,
  ]}
  aria-hidden="true"
>
  <Icon name="play" class="ml-[8%] size-[48%]" />
</span>
