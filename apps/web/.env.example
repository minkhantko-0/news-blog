# Public site URL (canonical links, sitemaps)
PUBLIC_SITE_URL=https://hollywoodpest.example

# Sanity. Leave empty to use the local sample content in src/lib/content/fixtures.ts
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Turnstile site key. Leave empty in dev to use Cloudflare's always-pass test key.
PUBLIC_TURNSTILE_SITE_KEY=
