---
import RichText from '~/components/portable/RichText.astro';
import CategoryView from '~/components/views/CategoryView.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { sectionPaths, type SectionRoute } from '~/lib/routes';
import { breadcrumbs } from '~/lib/seo/schema';

export const getStaticPaths = sectionPaths;

const route = Astro.props as SectionRoute;
---

{
  route.kind === 'category' ? (
    <BaseLayout
      title={route.category.seo.title ?? `${route.category.title} News`}
      description={route.category.seo.description ?? route.category.description ?? `The latest ${route.category.title} stories.`}
      noindex={route.category.seo.noindex}
      image={route.category.seo.image}
      schema={[breadcrumbs([{ name: route.category.title, path: route.category.href }])]}
      feed={{ title: `HollywoodPest: ${route.category.title}`, href: `${route.category.href}rss.xml` }}
    >
      <CategoryView category={route.category} pageNumber={1} />
    </BaseLayout>
  ) : (
    <BaseLayout
      title={route.page.seo.title ?? route.page.title}
      description={route.page.seo.description ?? route.page.title}
      noindex={route.page.seo.noindex}
      image={route.page.seo.image}
      schema={[breadcrumbs([{ name: route.page.title, path: route.page.href }])]}
    >
      <article class="mx-auto max-w-3xl px-4 py-10 lg:py-14">
        <h1 class="headline text-[2.6rem] font-black italic sm:text-[3.2rem]">{route.page.title}</h1>
        <div class="bg-gold-x mt-4 mb-8 h-1 w-24" aria-hidden="true" />
        <RichText value={route.page.body} />
      </article>
    </BaseLayout>
  )
}
