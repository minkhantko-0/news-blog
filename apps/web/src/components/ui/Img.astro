---
/**
 * Responsive image at a fixed aspect ratio. Always sets width/height so the
 * layout never shifts while images load.
 */
import type { MediaImage } from '~/lib/content';
import { responsiveImage } from '~/lib/images';

interface Props {
  image: MediaImage;
  /** Aspect ratio as [width, height]. */
  aspect: [number, number];
  /** The `sizes` attribute: how wide the image is shown at each breakpoint. */
  sizes: string;
  maxWidth?: number;
  /** Set true for the main above-the-fold image (LCP). */
  priority?: boolean;
  class?: string;
}

const { image, aspect, sizes, maxWidth, priority = false, class: className = '' } = Astro.props;
const { src, srcset, width, height } = responsiveImage(image, aspect, maxWidth);
---

<img
  src={src}
  srcset={srcset}
  sizes={sizes}
  width={width}
  height={height}
  alt={image.alt}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  class:list={['size-full object-cover', className]}
/>
