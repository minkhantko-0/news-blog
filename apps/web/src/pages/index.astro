---
import OriginalsStrip from '~/components/home/OriginalsStrip.astro';
import TrendingNow from '~/components/home/TrendingNow.astro';
import VideoList from '~/components/home/VideoList.astro';
import LeadStory from '~/components/story/LeadStory.astro';
import OverlayCard from '~/components/story/OverlayCard.astro';
import StoryCard from '~/components/story/StoryCard.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { content } from '~/lib/content';

const settings = await content.getSiteSettings();
const home = await content.getHomepage();
const container = 'mx-auto max-w-[1440px] px-3 sm:px-4 lg:px-6';
---

<BaseLayout
  title={`${settings.name}: Celebrity & Entertainment News`}
  description="Breaking celebrity, entertainment, sports and viral news, plus HollywoodPest Originals video."
>
  <h1 class="sr-only">{settings.name}: celebrity and entertainment news</h1>

  <!-- Top stories -->
  <section aria-label="Top stories" class:list={[container, 'pt-3 sm:pt-4 lg:pt-6']}>
    <div
      class="grid gap-4 md:grid-cols-2 lg:h-[440px] lg:grid-cols-[minmax(0,2.2fr)_minmax(0,1.35fr)_minmax(0,1fr)] xl:h-[480px]"
    >
      <div class="md:col-span-2 lg:col-span-1 lg:h-full">
        <LeadStory story={home.lead} />
      </div>
      <div class="grid gap-4 md:col-span-2 md:grid-cols-2 lg:col-span-1 lg:grid-cols-1 lg:grid-rows-2">
        {home.secondary.map((story) => <OverlayCard story={story} />)}
      </div>
      <div class="md:col-span-2 lg:col-span-1 lg:h-full">
        <TrendingNow stories={home.trending} />
      </div>
    </div>
  </section>

  <!-- Originals -->
  {
    home.shows.length > 0 && (
      <div class:list={[container, 'mt-6 lg:mt-8']}>
        <OriginalsStrip shows={home.shows} />
      </div>
    )
  }

  <!-- Latest + Videos -->
  <div class:list={[container, 'mt-8 grid gap-10 lg:mt-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] lg:gap-8']}>
    <section aria-labelledby="latest-title">
      <SectionHeading id="latest-title" title="Latest News" />
      <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {home.latest.map((story) => <StoryCard story={story} />)}
      </div>
    </section>

    {
      home.videos.length > 0 && (
        <section aria-labelledby="videos-title" class="lg:border-line lg:border-l lg:pl-8">
          <SectionHeading id="videos-title" title="Videos" playIcon link={{ label: 'View all', href: '/videos/' }} />
          <VideoList videos={home.videos} />
        </section>
      )
    }
  </div>
</BaseLayout>
