---
/**
 * Text-built wordmark until a real logo file (SVG) exists.
 * `variant="dark"` is for black backgrounds (footer).
 */
import Icon from './Icon.astro';

interface Props {
  variant?: 'light' | 'dark';
  /** Shows the tagline under the wordmark. */
  tagline?: string;
  class?: string;
}

const { variant = 'light', tagline, class: className = '' } = Astro.props;
---

<a href="/" class:list={['group inline-flex flex-col items-center leading-none', className]} aria-label="HollywoodPest home">
  <span
    class="font-display text-[1.9rem] font-black italic tracking-[-0.01em] whitespace-nowrap uppercase sm:text-[2.6rem] lg:text-[3.2rem] xl:text-[3.6rem] 2xl:text-[4rem]"
    aria-hidden="true"
  >
    <span class={variant === 'dark' ? 'text-white' : 'text-ink'}>Hollywood</span><span class="text-gold-gradient pr-[0.08em]">Pest</span>
  </span>
  <span class="relative mt-0.5 flex w-[92%] items-center" aria-hidden="true">
    <span class="bg-gold-x h-[2px] flex-1"></span>
    <Icon name="star" class="text-gold-500 mx-1 size-3 sm:size-4 lg:size-6 lg:-my-1" />
    <span class="bg-gold-x h-[2px] flex-1"></span>
  </span>
  {
    tagline && (
      <span
        class:list={[
          'mt-1 font-sans text-[0.6rem] font-medium tracking-[0.32em] uppercase lg:mt-1.5 lg:text-[0.8rem]',
          // The header on phones is kept compact: tagline from small tablets up.
          variant === 'dark' ? 'text-white/80' : 'text-ink/80 max-sm:hidden',
        ]}
      >
        {tagline}
      </span>
    )
  }
</a>
