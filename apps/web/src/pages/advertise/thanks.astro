---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Your enquiry was sent" description="Our team will reply by email, usually within two working days." noindex>
  <section class="mx-auto max-w-xl px-4 py-20 text-center">
    <p class="headline text-gold-gradient text-[4rem] font-black italic">Thank you</p>
    <h1 class="headline mt-2 text-[2rem] font-black italic">Your enquiry was sent</h1>
    <p class="text-muted mt-4 text-lg">Our team will reply by email, usually within two working days.</p>
    <a href="/" class="bg-gold headline mt-8 inline-block rounded-sm px-8 py-3 text-lg font-extrabold">Back to the news</a>
  </section>
</BaseLayout>
