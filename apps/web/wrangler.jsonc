{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-blog",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",

  // Live address. Cloudflare creates the DNS record and certificate on deploy.
  // www → root is a Redirect Rule on the zone (dashboard), not served here.
  "routes": [{ "pattern": "hollywoodpestmedia.com", "custom_domain": true }],
  // Only the real domain: no duplicate copy of the site on *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,

  // Static HTML from `astro build`. Requests to these files are free and unlimited.
  // Only /api/* runs the Worker (forms), so page views never count against Worker limits.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // Private storage for the forms. Created at deploy time (see docs/DEPLOY.md);
  // `wrangler dev` simulates both locally.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "news-blog",
      "database_id": "3cc782ab-86f1-4c9c-8ca1-0607f155468f",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [{ "binding": "TIP_FILES", "bucket_name": "news-blog-tip-files" }],

  // New tips and advertising enquiries are emailed to the newsroom inbox
  // (Cloudflare Email Routing on hollywoodpestmedia.com). The inbox must be a
  // verified destination address in Email Routing. To change it, update both
  // destination_address and NOTIFY_TO, and verify the new address first.
  "send_email": [{ "name": "SEND_EMAIL", "destination_address": "hollywoodpest@outlook.com" }],
  "vars": {
    "NOTIFY_FROM": "tips@hollywoodpestmedia.com",
    "NOTIFY_TO": "hollywoodpest@outlook.com"
  },

  "observability": { "enabled": true }
}
