{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-blog-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Cron-only Worker: no public workers.dev address.
  "workers_dev": false,
  "preview_urls": false,

  // Every 5 minutes: publish scheduled stories that are due.
  // 07:15 UTC daily (2:15/3:15am New York): back up all Sanity content to R2.
  "triggers": { "crons": ["*/5 * * * *", "15 7 * * *"] },

  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "news-blog-backups" }],

  "vars": {
    "SANITY_PROJECT_ID": "bgva358g",
    "SANITY_DATASET": "production",
    "BACKUP_KEEP_DAYS": "30"
  },
  // Secrets (`wrangler secret put`, or .dev.vars locally):
  //   SANITY_WRITE_TOKEN  Sanity API token with the Editor role
  //   DEPLOY_HOOK_URL     optional: Workers Builds deploy hook, to rebuild when a story goes live

  "observability": { "enabled": true }
}
