---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Your tip was sent" description="Our editors will look at it. If you left contact details, we may get in touch." noindex>
  <section class="mx-auto max-w-xl px-4 py-20 text-center">
    <p class="headline text-gold-gradient text-[4rem] font-black italic">Thank you</p>
    <h1 class="headline mt-2 text-[2rem] font-black italic">Your tip was sent</h1>
    <p class="text-muted mt-4 text-lg">Our editors will look at it. If you left contact details, we may get in touch.</p>
    <a href="/" class="bg-gold headline mt-8 inline-block rounded-sm px-8 py-3 text-lg font-extrabold">Back to the news</a>
  </section>
</BaseLayout>
