---
/** Slide-in menu for phones/tablets. Opened by any [data-open-menu] button. */
import type { SiteSettings } from '~/lib/content';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import NavLink from './NavLink.astro';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
---

<dialog
  id="site-menu"
  aria-label="Menu"
  class="bg-paper text-ink m-0 h-dvh max-h-none w-[min(88vw,380px)] max-w-none p-0 lg:hidden"
>
  <div class="flex h-full flex-col">
    <div class="border-line flex items-center justify-between border-b px-4 py-3">
      <Logo />
      <button type="button" class="-mr-2 p-2" data-close-menu aria-label="Close menu">
        <Icon name="close" class="size-7" />
      </button>
    </div>

    <nav aria-label="Menu sections" class="flex-1 overflow-y-auto overscroll-contain">
      <ul class="divide-line divide-y">
        <li>
          <a href="/" class="headline block px-4 py-3.5 text-xl font-extrabold">Home</a>
        </li>
        {
          settings.nav.map((item) =>
            item.children.length > 0 ? (
              <li>
                <details class="group">
                  <summary class="headline flex cursor-pointer list-none items-center justify-between px-4 py-3.5 text-xl font-extrabold [&::-webkit-details-marker]:hidden">
                    {item.label}
                    <Icon name="chevron-down" class="size-5 transition-transform group-open:rotate-180" />
                  </summary>
                  <ul class="bg-gold-200/40 pb-2">
                    <li>
                      <NavLink item={item} class="block px-6 py-2 font-display text-lg font-bold uppercase">
                        All {item.label}
                      </NavLink>
                    </li>
                    {item.children.map((child) => (
                      <li>
                        <NavLink item={child} class="block px-6 py-2 font-display text-lg font-bold uppercase" />
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <NavLink item={item} class="headline block px-4 py-3.5 text-xl font-extrabold" />
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="border-line space-y-4 border-t p-4">
      <div class="grid grid-cols-2 gap-3">
        <a href="/news-tip/" class="headline border-ink flex items-center justify-center gap-2 border-2 py-2.5 font-extrabold">
          <Icon name="mail" class="size-5" /> News Tip
        </a>
        <a href="/advertise/" class="bg-gold headline flex items-center justify-center py-2.5 font-extrabold">Advertise</a>
      </div>
      <SocialLinks links={settings.social} class="justify-center" iconClass="size-6" />
    </div>
  </div>
</dialog>

<style>
  #site-menu[open] {
    animation: slide-in 0.2s ease-out;
  }
  @keyframes slide-in {
    from {
      transform: translateX(-100%);
    }
  }
</style>
