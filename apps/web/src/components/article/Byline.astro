---
/** Author photos, names and publish/update times under the headline. */
import type { AuthorSummary } from '~/lib/content';
import { formatDateTime } from '~/lib/format';
import Img from '../ui/Img.astro';

interface Props {
  authors: AuthorSummary[];
  publishedAt: string;
  updatedAt?: string;
}

const { authors, publishedAt, updatedAt } = Astro.props;
const showUpdated = updatedAt && new Date(updatedAt).getTime() > new Date(publishedAt).getTime();
---

<div class="flex items-center gap-3">
  <div class="flex -space-x-2">
    {
      authors
        .filter((a) => a.photo)
        .map((a) => (
          <div class="ring-paper size-11 overflow-hidden rounded-full ring-2">
            <Img image={a.photo!} aspect={[1, 1]} sizes="44px" maxWidth={400} />
          </div>
        ))
    }
  </div>
  <div class="text-sm leading-snug">
    <p class="font-semibold">
      {'By '}
      {
        authors.map((a, i) => (
          <>
            {i > 0 && (i === authors.length - 1 ? ' and ' : ', ')}
            <a href={a.href} rel="author" class="decoration-gold-500 underline decoration-2 underline-offset-2 hover:text-gold-700">
              {a.name}
            </a>
          </>
        ))
      }
    </p>
    <p class="text-muted" data-pagefind-ignore>
      Published <time datetime={publishedAt}>{formatDateTime(publishedAt)}</time>
      {
        showUpdated && (
          <>
            <span aria-hidden="true"> · </span>
            Updated <time datetime={updatedAt}>{formatDateTime(updatedAt!)}</time>
          </>
        )
      }
    </p>
  </div>
</div>
