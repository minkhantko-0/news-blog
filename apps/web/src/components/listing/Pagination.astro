---
/** Previous / page numbers / Next. Page 1 is the base URL; others are base/page/N/. */
import Icon from '../ui/Icon.astro';

interface Props {
  current: number;
  total: number;
  /** URL of page 1, e.g. /news/ */
  base: string;
}

const { current, total, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}page/${n}/`);

// Show first, last, and two either side of the current page.
const pages = Array.from({ length: total }, (_, i) => i + 1).filter(
  (n) => n === 1 || n === total || Math.abs(n - current) <= 2,
);

const item = 'flex h-10 min-w-10 items-center justify-center px-3 font-display text-lg font-bold';
---

{
  total > 1 && (
    <nav aria-label="Pagination" class="mt-10 flex flex-wrap items-center justify-center gap-1.5">
      {current > 1 && (
        <a href={href(current - 1)} rel="prev" class:list={[item, 'border-line hover:border-ink border']}>
          <Icon name="chevron-left" class="mr-1 size-4" /> Prev
        </a>
      )}
      {pages.map((n, i) => (
        <>
          {i > 0 && n - pages[i - 1]! > 1 && <span class="text-muted px-1">…</span>}
          {n === current ? (
            <span aria-current="page" class:list={[item, 'bg-gold']}>
              {n}
            </span>
          ) : (
            <a href={href(n)} class:list={[item, 'border-line hover:border-ink border']}>
              {n}
            </a>
          )}
        </>
      ))}
      {current < total && (
        <a href={href(current + 1)} rel="next" class:list={[item, 'border-line hover:border-ink border']}>
          Next <Icon name="chevron-right" class="ml-1 size-4" />
        </a>
      )}
    </nav>
  )
}
