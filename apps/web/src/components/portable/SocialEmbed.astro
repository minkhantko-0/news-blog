---
/**
 * Social post (Instagram, TikTok, X, YouTube, Facebook).
 *
 * Renders a lightweight card first. The platform's own embed (and its heavy
 * script) loads only when the card scrolls near the screen, so embeds never
 * slow down the first view of the page.
 */
import { youtubeId } from '~/lib/youtube';
import Icon, { type IconName } from '../ui/Icon.astro';
import YouTubePlayer from '../media/YouTubePlayer.astro';

interface Props {
  node: { url: string };
}

const { url } = Astro.props.node;

const host = (() => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
})();

const platform: { name: string; icon: IconName; kind: string } = host.endsWith('instagram.com')
  ? { name: 'Instagram', icon: 'instagram', kind: 'instagram' }
  : host.endsWith('tiktok.com')
    ? { name: 'TikTok', icon: 'tiktok', kind: 'tiktok' }
    : host === 'x.com' || host.endsWith('twitter.com')
      ? { name: 'X', icon: 'x', kind: 'x' }
      : host.endsWith('youtube.com') || host === 'youtu.be'
        ? { name: 'YouTube', icon: 'youtube', kind: 'youtube' }
        : { name: 'Facebook', icon: 'facebook', kind: 'link' };

const ytId = platform.kind === 'youtube' ? youtubeId(url) : undefined;
---

{
  ytId ? (
    <div class="not-prose my-8">
      <YouTubePlayer youtubeId={ytId} title="YouTube video" image={{ alt: 'YouTube video', source: { url: `https://i.ytimg.com/vi/${ytId}/hqdefault.jpg` } }} />
    </div>
  ) : (
    <div class="not-prose my-8 flex justify-center" data-embed={platform.kind} data-embed-url={url}>
      <a
        href={url}
        target="_blank"
        rel="noopener"
        class="border-line hover:border-gold-500 flex min-h-40 w-full max-w-[540px] flex-col items-center justify-center gap-3 rounded-md border bg-neutral-50 p-6 text-center transition"
      >
        <Icon name={platform.icon} class="size-9" />
        <span class="font-display text-lg font-bold uppercase">View this post on {platform.name}</span>
        <span class="text-muted max-w-full truncate text-xs">{host}</span>
      </a>
    </div>
  )
}

<script>
  /** `markup` wraps the link card, so the card stays visible until the platform draws the post. */
  type Loader = { src: string; markup: (url: string, card: string) => string; process?: (el: HTMLElement) => void };

  const loaders: Record<string, Loader> = {
    instagram: {
      src: 'https://www.instagram.com/embed.js',
      markup: (url, card) =>
        `<blockquote class="instagram-media" data-instgrm-permalink="${url}" data-instgrm-version="14" style="max-width:540px;width:100%;margin:0 auto;border:0;padding:0;background:none">${card}</blockquote>`,
      process: () => (window as unknown as { instgrm?: { Embeds: { process(): void } } }).instgrm?.Embeds.process(),
    },
    tiktok: {
      src: 'https://www.tiktok.com/embed.js',
      markup: (url, card) => {
        const id = url.match(/video\/(\d+)/)?.[1] ?? '';
        return `<blockquote class="tiktok-embed" cite="${url}" data-video-id="${id}" style="max-width:605px;min-width:325px;border:0;margin:0 auto"><section>${card}</section></blockquote>`;
      },
    },
    x: {
      src: 'https://platform.twitter.com/widgets.js',
      // The card is a link to the post, which is what X's script looks for.
      markup: (_url, card) => `<blockquote class="twitter-tweet" data-dnt="true" style="margin:0">${card}</blockquote>`,
      process: (el) => (window as unknown as { twttr?: { widgets: { load(e: HTMLElement): void } } }).twttr?.widgets.load(el),
    },
  };

  /** True once the platform has drawn the post (an iframe of real height). */
  const rendered = (el: HTMLElement) => [...el.querySelectorAll('iframe')].some((f) => f.offsetHeight >= 100);

  /**
   * Deleted, private or fake posts make some platforms draw nothing (or an
   * empty box). Bring the link card back if no post appears in time.
   */
  const restoreIfEmpty = (el: HTMLElement, card: string) => {
    const started = Date.now();
    const timer = setInterval(() => {
      if (rendered(el)) return clearInterval(timer);
      if (Date.now() - started > 15_000) {
        clearInterval(timer);
        el.innerHTML = card;
      }
    }, 1500);
  };

  const loadedScripts = new Map<string, Promise<void>>();
  const loadScript = (src: string) => {
    if (!loadedScripts.has(src)) {
      loadedScripts.set(
        src,
        new Promise((resolve, reject) => {
          const s = document.createElement('script');
          s.src = src;
          s.async = true;
          s.onload = () => resolve();
          s.onerror = () => reject(new Error(`Failed to load ${src}`));
          document.body.append(s);
        }),
      );
    }
    return loadedScripts.get(src)!;
  };

  const embed = async (el: HTMLElement) => {
    const loader = loaders[el.dataset.embed ?? ''];
    const url = el.dataset.embedUrl;
    if (!loader || !url) return; // unsupported platforms keep the link card
    const card = el.innerHTML;
    el.innerHTML = loader.markup(url.replace(/"/g, '&quot;'), card);
    try {
      const firstLoad = !loadedScripts.has(loader.src);
      await loadScript(loader.src);
      if (!firstLoad) loader.process?.(el); // the script processes the page itself on first load
      restoreIfEmpty(el, card);
    } catch {
      el.innerHTML = card; // blocked or offline: keep the link card
    }
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        embed(entry.target as HTMLElement);
      }
    },
    { rootMargin: '400px 0px' },
  );
  document.querySelectorAll<HTMLElement>('[data-embed]').forEach((el) => observer.observe(el));
</script>
