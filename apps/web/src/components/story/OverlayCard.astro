---
/**
 * Secondary hero story. On phones it is a compact row (thumbnail + headline);
 * from tablet up the headline sits over the image, as in the design.
 */
import type { StorySummary } from '~/lib/content';
import Img from '../ui/Img.astro';
import PlayBadge from '../ui/PlayBadge.astro';
import StoryTag from '../ui/StoryTag.astro';

interface Props {
  story: StorySummary;
}

const { story } = Astro.props;
---

<article class="group relative md:aspect-[16/10] md:overflow-hidden lg:aspect-auto lg:h-full">
  <a href={story.href} class="flex gap-3 md:block md:h-full">
    <div class="bg-line relative aspect-[4/3] w-[38%] shrink-0 overflow-hidden md:absolute md:inset-0 md:aspect-auto md:w-full">
      <Img
        image={story.image}
        aspect={[16, 10]}
        sizes="(min-width: 1440px) 420px, (min-width: 1024px) 30vw, (min-width: 768px) 50vw, 38vw"
        maxWidth={1200}
        class="transition duration-500 group-hover:scale-[1.03]"
      />
      {story.hasVideo && <PlayBadge size="sm" class="absolute right-1.5 bottom-1.5 md:hidden" />}
    </div>
    <div
      class="absolute inset-0 hidden bg-gradient-to-t from-black/90 via-black/30 to-transparent md:block"
      aria-hidden="true"
    >
    </div>
    <div class="min-w-0 flex-1 md:absolute md:inset-x-0 md:bottom-0 md:flex md:items-end md:gap-3 md:p-4">
      <div class="min-w-0 flex-1">
        <StoryTag story={story} />
        <h3
          class="headline group-hover:text-gold-600 md:group-hover:text-gold-300 mt-1.5 line-clamp-4 text-[1.15rem] md:text-[1.35rem] md:text-white lg:text-[1.2rem] xl:text-[1.4rem] 2xl:text-[1.55rem]"
        >
          {story.title}
        </h3>
      </div>
      {
        story.hasVideo && (
          <span class="hidden md:block">
            <PlayBadge />
          </span>
        )
      }
    </div>
  </a>
</article>
