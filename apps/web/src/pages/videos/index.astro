---
import Breadcrumbs from '~/components/article/Breadcrumbs.astro';
import VideoCard from '~/components/media/VideoCard.astro';
import YouTubePlayer from '~/components/media/YouTubePlayer.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { content } from '~/lib/content';

const [videos, shows] = await Promise.all([content.getVideos(), content.getShows()]);
const [featured, ...rest] = videos;
---

<BaseLayout title="Videos" description="Celebrity, entertainment and viral videos, plus HollywoodPest Originals.">
  <div class="mx-auto max-w-[1440px] px-3 pt-4 sm:px-4 lg:px-6 lg:pt-6">
    <Breadcrumbs items={[{ label: 'Videos' }]} class="mb-3" />
    <h1 class="headline mb-6 text-[2.6rem] font-black italic sm:text-[3.4rem]">Videos</h1>

    {
      featured && (
        <section class="bg-night -mx-3 mb-10 grid gap-6 p-4 text-white sm:mx-0 sm:rounded-md sm:p-6 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:items-center">
          <YouTubePlayer youtubeId={featured.youtubeId} title={featured.title} image={featured.image} priority />
          <div>
            {featured.show && (
              <a href={featured.show.href} class="text-gold-400 font-display text-sm font-extrabold tracking-widest uppercase hover:underline">
                {featured.show.name}
              </a>
            )}
            <h2 class="headline mt-2 text-[2rem] sm:text-[2.4rem]">
              <a href={featured.href} class="hover:text-gold-300">{featured.title}</a>
            </h2>
            {featured.description && <p class="mt-3 text-white/75">{featured.description}</p>}
          </div>
        </section>
      )
    }

    {
      shows.length > 0 && (
        <nav aria-label="Originals" class="mb-8 flex flex-wrap gap-2">
          {shows.map((show) => (
            <a href={show.href} class="border-ink hover:bg-ink inline-block border-2 px-3 py-1 font-display text-sm font-extrabold uppercase hover:text-white">
              {show.name}
            </a>
          ))}
        </nav>
      )
    }

    <SectionHeading title="Latest Videos" />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {rest.map((video) => <VideoCard video={video} />)}
    </div>
  </div>
</BaseLayout>
