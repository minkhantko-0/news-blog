---
import type { StorySummary } from '~/lib/content';
import Icon from '../ui/Icon.astro';

interface Props {
  stories: StorySummary[];
}

const { stories } = Astro.props;
---

<aside aria-labelledby="trending-title" class="border-line flex flex-col border lg:h-full lg:overflow-hidden">
  <h2 id="trending-title" class="bg-gold headline flex items-center gap-2 px-4 py-2.5 text-[1.6rem] font-black italic">
    <Icon name="flame" class="size-6" />
    Trending Now
  </h2>
  <ol class="divide-line flex flex-1 flex-col divide-y">
    {
      stories.map((story, i) => (
        <li class="min-h-0 flex-1">
          <a href={story.href} class="group flex h-full items-center gap-3 px-3 py-2.5 lg:py-1.5">
            <span class="bg-gold flex size-9 shrink-0 items-center justify-center font-display text-xl font-black" aria-hidden="true">
              {i + 1}
            </span>
            {/* The desktop hero has a fixed height: 2 lines until there's room for 3. */}
            <span class="group-hover:text-gold-600 line-clamp-3 font-display text-[1.1rem] leading-tight font-bold lg:line-clamp-2 lg:text-[1.05rem] 2xl:line-clamp-3 2xl:text-[1.1rem]">
              {story.title}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</aside>
