---
import '~/styles/global.css';
import { Font } from 'astro:assets';
import ComingSoonDialog from '~/components/layout/ComingSoonDialog.astro';
import Footer from '~/components/layout/Footer.astro';
import Header from '~/components/layout/Header.astro';
import MobileMenu from '~/components/layout/MobileMenu.astro';
import { content, type MediaImage } from '~/lib/content';
import { graph, type GraphNode } from '~/lib/seo/schema';
import { ALLOW_INDEXING, LOCALE, shareImage, xHandle } from '~/lib/seo/site';

interface Props {
  title: string;
  description: string;
  /** Keep this page out of search results. */
  noindex?: boolean;
  /** Image for link previews (Facebook, X, WhatsApp, Discover). Defaults to the site's share image. */
  image?: MediaImage;
  type?: 'website' | 'article' | 'video.other' | 'profile';
  /** Open Graph article details. */
  article?: { publishedAt: string; updatedAt?: string; section?: string; tags?: string[]; authorUrls?: string[] };
  /** Structured data for this page; the organization and website are added automatically. */
  schema?: GraphNode[];
  /** Extra RSS feed for this page (e.g. a section's feed). */
  feed?: { title: string; href: string };
}

const { title, description, noindex = false, image, type = 'website', article, schema = [], feed } = Astro.props;
const settings = await content.getSiteSettings();
const fullTitle = title.includes(settings.name) ? title : `${title} | ${settings.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageOrigin = import.meta.env.PUBLIC_SANITY_PROJECT_ID ? 'https://cdn.sanity.io' : 'https://picsum.photos';

// Until launch (PUBLIC_ALLOW_INDEXING=true) every page stays out of search results.
const robots = !ALLOW_INDEXING
  ? 'noindex, nofollow'
  : noindex
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const share = shareImage(image ?? settings.defaultShareImage);
const twitterSite = xHandle(settings.social);
// "<" escaped so text in the data can never close the script tag.
const jsonLd = JSON.stringify(graph(settings, schema)).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#111111" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${settings.name}: Latest`} href="/rss.xml" />
    {feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />}

    <!-- Link previews (Facebook, WhatsApp, LinkedIn, X) -->
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALE} />
    <meta property="og:image" content={share.url} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={share.alt} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedAt} />
          {article.updatedAt && <meta property="article:modified_time" content={article.updatedAt} />}
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
          {article.authorUrls?.map((url) => <meta property="article:author" content={url} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    {twitterSite && <meta name="twitter:site" content={twitterSite} />}

    <!-- Structured data for Google and AI search -->
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="preconnect" href={imageOrigin} crossorigin />
    <Font
      cssVariable="--font-barlow"
      preload={[
        { weight: '800', style: 'normal' },
        { weight: '900', style: 'italic' },
      ]}
    />
    <Font cssVariable="--font-inter" />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="bg-gold text-ink sr-only z-50 px-4 py-2 font-bold focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <Header settings={settings} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} />
    <MobileMenu settings={settings} />
    <ComingSoonDialog />

    <script>
      // Relative publish times ("2 hours ago"), computed in the reader's browser.
      const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
      const units: [Intl.RelativeTimeFormatUnit, number][] = [
        ['year', 31536000],
        ['month', 2592000],
        ['week', 604800],
        ['day', 86400],
        ['hour', 3600],
        ['minute', 60],
      ];
      for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-relative]')) {
        const seconds = (new Date(el.dateTime).getTime() - Date.now()) / 1000;
        if (Number.isNaN(seconds) || Math.abs(seconds) > 7 * 86400) continue; // older than a week: keep the date
        const [unit, size] = units.find(([, s]) => Math.abs(seconds) >= s) ?? ['minute', 60];
        el.textContent = rtf.format(Math.round(seconds / size), unit);
      }

      // Mobile menu
      const menu = document.getElementById('site-menu') as HTMLDialogElement | null;
      document.querySelectorAll('[data-open-menu]').forEach((b) => b.addEventListener('click', () => menu?.showModal()));
      menu?.querySelector('[data-close-menu]')?.addEventListener('click', () => menu.close());
      menu?.addEventListener('click', (e) => e.target === menu && menu.close()); // tap outside

      // "Coming soon" popup
      const soon = document.getElementById('coming-soon') as HTMLDialogElement | null;
      const soonName = soon?.querySelector('[data-coming-soon-name]');
      soon?.addEventListener('click', (e) => e.target === soon && soon.close());
      document.addEventListener('click', (e) => {
        const link = (e.target as Element).closest<HTMLElement>('[data-coming-soon]');
        if (!link || !soon || !soonName) return;
        e.preventDefault();
        menu?.close();
        soonName.textContent = link.dataset.comingSoon ?? 'This';
        soon.showModal();
      });

      // Overscroll colour: bouncing past the bottom of the page (Mac, iPhone) should
      // show the dark footer colour, past the top the white header colour.
      // Dark once the reader is in the lower half of the page. See html.at-footer.
      let overscrollFrame = 0;
      const updateOverscroll = () => {
        overscrollFrame = 0;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        document.documentElement.classList.toggle('at-footer', maxScroll > 0 && window.scrollY >= maxScroll / 2);
      };
      const queueOverscroll = () => (overscrollFrame ||= requestAnimationFrame(updateOverscroll));
      window.addEventListener('scroll', queueOverscroll, { passive: true });
      window.addEventListener('resize', queueOverscroll, { passive: true });
      updateOverscroll();

      // Carousels: arrow buttons scroll the track
      for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
        const track = root.querySelector<HTMLElement>('[data-carousel-track]');
        if (!track) continue;
        const step = () => track.clientWidth * 0.8;
        root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
        root.querySelector('[data-carousel-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
      }
    </script>
  </body>
</html>
