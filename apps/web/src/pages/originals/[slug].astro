---
import Breadcrumbs from '~/components/article/Breadcrumbs.astro';
import VideoCard from '~/components/media/VideoCard.astro';
import Img from '~/components/ui/Img.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { content, type ShowDetail } from '~/lib/content';

export async function getStaticPaths() {
  const shows = await content.getShows();
  return shows.map((show) => ({ params: { slug: show.slug }, props: { show } }));
}

const { show } = Astro.props as { show: ShowDetail };
const episodes = (await content.getVideos()).filter((v) => v.show?.id === show.id);
---

<BaseLayout title={`${show.name}: A HollywoodPest Original`} description={show.description ?? `Watch ${show.name}, a HollywoodPest Original.`}>
  <section class="bg-night relative overflow-hidden text-white">
    <div class="absolute inset-0 opacity-40">
      <Img image={show.image} aspect={[16, 6]} sizes="100vw" priority maxWidth={1600} />
    </div>
    <div class="relative mx-auto max-w-[1440px] px-4 py-14 lg:px-6 lg:py-20">
      <Breadcrumbs items={[{ label: 'Originals', href: '/originals/' }, { label: show.name }]} class="mb-4 [&_*]:text-white/80" />
      <h1 class="headline text-[3rem] font-black italic sm:text-[4.2rem]">{show.name}</h1>
      {show.description && <p class="mt-3 max-w-2xl text-lg text-white/85">{show.description}</p>}
    </div>
    <div class="bg-gold-x h-1" aria-hidden="true"></div>
  </section>

  <div class="mx-auto max-w-[1440px] px-3 pt-8 sm:px-4 lg:px-6">
    <SectionHeading title="Episodes" playIcon />
    {
      episodes.length === 0 ? (
        <p class="text-muted py-10">New episodes coming soon.</p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {episodes.map((v) => (
            <VideoCard video={v} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
