---
/**
 * Inline SVG icons. Brand marks are filled; UI icons are stroked.
 * Decorative by default (aria-hidden); pass `label` to make one meaningful.
 */
export type IconName =
  | 'instagram'
  | 'tiktok'
  | 'facebook'
  | 'youtube'
  | 'x'
  | 'mail'
  | 'search'
  | 'menu'
  | 'close'
  | 'home'
  | 'chevron-down'
  | 'chevron-left'
  | 'chevron-right'
  | 'play'
  | 'flame'
  | 'star';

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className = 'size-6', label } = Astro.props;

const stroked: Partial<Record<IconName, string>> = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 6 8.5 7 8.5-7"/>',
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  close: '<path d="M5 5l14 14M19 5 5 19"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  'chevron-left': '<path d="m15 5-7 7 7 7"/>',
  'chevron-right': '<path d="m9 5 7 7-7 7"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="0.6" fill="currentColor"/>',
};

const filled: Partial<Record<IconName, string>> = {
  tiktok:
    '<path d="M16.6 2.5c.4 2.5 1.9 4 4.4 4.2v3.3c-1.6.1-3-.4-4.4-1.3v6.6a6 6 0 1 1-6-6c.3 0 .6 0 .9.1v3.4a2.7 2.7 0 1 0 1.9 2.6V2.5h3.2z"/>',
  facebook:
    '<path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/>',
  youtube:
    '<path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/>',
  x: '<path d="M18.2 2h3.4l-7.4 8.5L23 22h-6.8l-5.3-7-6.1 7H1.4l7.9-9.1L1 2h7l4.8 6.4L18.2 2zm-1.2 18h1.9L7.1 3.9H5.1L17 20z"/>',
  home: '<path d="M12 2.8 1.5 12h3v9h5.8v-6h3.4v6h5.8v-9h3z"/>',
  // Optically centred: the triangle's centre of mass sits just right of x=12.
  play: '<path d="M8.4 5.2v13.6a.6.6 0 0 0 .9.5l10.6-6.8a.6.6 0 0 0 0-1L9.3 4.7a.6.6 0 0 0-.9.5z"/>',
  flame:
    '<path d="M12.6 1.8c.5 3.2-1 5-2.6 6.8C8.3 10.4 6.5 12.3 6.5 15.4A5.6 5.6 0 0 0 12 21.2a5.6 5.6 0 0 0 5.5-5.8c0-2.4-1-4.2-2.2-5.6-.2 1.6-.9 2.7-2 3.2.5-3.7-.3-7.6-.7-11.2z"/>',
  star: '<path d="m12 2.5 2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z"/>',
};

const isStroked = name in stroked;
const body = (isStroked ? stroked[name] : filled[name]) ?? '';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  fill={isStroked ? 'none' : 'currentColor'}
  stroke={isStroked ? 'currentColor' : 'none'}
  stroke-width={isStroked ? 2 : undefined}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
