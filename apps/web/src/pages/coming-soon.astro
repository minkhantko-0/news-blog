---
/** No-JavaScript fallback for "coming soon" nav items. Not indexed. */
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Coming Soon" description="This part of HollywoodPest is launching soon." noindex>
  <section class="mx-auto max-w-xl px-4 py-20 text-center">
    <h1 class="headline text-[2.6rem] font-black italic">Coming soon</h1>
    <p class="text-muted mt-4">We're putting the finishing touches on it. Follow HollywoodPest on social to be first to know when it launches.</p>
    <a href="/" class="bg-gold headline mt-8 inline-block rounded-sm px-8 py-3 text-lg font-extrabold">Back to the news</a>
  </section>
</BaseLayout>
